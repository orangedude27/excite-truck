# IDE folders
.idea/
.vs/

# Caches
__pycache__
.mypy_cache
.cache/

# Original files
orig/*/*
!orig/*/.gitkeep
*.dol
*.rel
*.elf
*.o
*.map
*.MAP

# Build files
build/
.ninja_*
build.ninja

# decompctx output
ctx.*
*.ctx

# Generated configs
objdiff.json
compile_commands.json

# Miscellaneous
/*.txt
*.exe

# Documentation: only README.md (and docs/*.md) are tracked. Other .md
# files (TODO_*, drift notes, AGENTS.md, README.example.md) are working-only.
*.md
!README.md
!docs/*.md

# Tools/ is also working-only — scripts under tools/ are not tracked.
tools/

*.s
